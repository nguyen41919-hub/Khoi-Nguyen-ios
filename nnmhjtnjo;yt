                price: 20000,
                originalPrice: 100000,
                image: 'https://images.unsplash.com/photo-1511512578047-dfb367046420?w=600&auto=format&fit=crop&q=80',
                highlights: ['Tỷ lệ trúng Acc cấp Cao 50%', 'Trắng thông tin 100%'],
                secret: 'random_lq_acc@gmail.com | Pass: Random2026',
                status: 'available'
            }
        ];

        function saveAccountsToStorage() {
            localStorage.setItem('nexus_accounts', JSON.stringify(accounts));
        }

        function filterCategory(cat) {
            currentCategory = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.classList.remove('bg-cyan-500', 'text-white');
                btn.classList.add('bg-darkBg', 'text-slate-300');
            });
            event.target.classList.add('bg-cyan-500', 'text-white');
            event.target.classList.remove('bg-darkBg', 'text-slate-300');
            renderAccounts();
        }

        function renderAccounts() {
            const grid = document.getElementById('accountGrid');
            const searchInput = document.getElementById('searchInput');
            const search = searchInput ? searchInput.value.toLowerCase() : '';

            let filtered = accounts.filter(acc => {
                const matchCat = currentCategory === 'all' || acc.category === currentCategory;
                const matchSearch = acc.code.toLowerCase().includes(search) || acc.rank.toLowerCase().includes(search);
                return matchCat && matchSearch;
            });

            if (filtered.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-12 text-slate-500">Chưa có tài khoản nào trong danh mục này!</div>`;
                return;
            }

            grid.innerHTML = filtered.map(acc => `
                <div class="bg-darkCard border border-darkBorder rounded-3xl overflow-hidden group hover:border-cyan-500/50 transition duration-300 flex flex-col justify-between">
                    <div>
                        <div class="relative overflow-hidden aspect-video">
                            <img src="${acc.image}" alt="Acc" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                            <span class="absolute top-3 left-3 bg-darkBg/80 backdrop-blur-md text-cyan-400 border border-cyan-500/30 text-xs px-3 py-1 rounded-full font-bold uppercase">${getCategoryName(acc.category)}</span>
                            <span class="absolute top-3 right-3 bg-purple-500 text-white text-xs px-3 py-1 rounded-full font-extrabold">${acc.code}</span>
                            ${acc.status === 'sold' ? '<div class="absolute inset-0 bg-black/80 flex items-center justify-center font-black text-red-500 text-xl uppercase tracking-widest">Đã Bán</div>' : ''}
                        </div>
                        <div class="p-5">
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-sm font-bold text-slate-200"><i class="fa-solid fa-trophy text-yellow-400 mr-1"></i> ${acc.rank}</span>
                            </div>
                            <ul class="space-y-1 mb-4 text-xs text-slate-400">
                                ${acc.highlights.map(h => `<li><i class="fa-solid fa-check text-emerald-400 mr-1"></i> ${h}</li>`).join('')}
                            </ul>
                        </div>
                    </div>
                    <div class="p-5 pt-0 flex items-center justify-between border-t border-darkBorder/50 mt-4">
                        <div>
                            <span class="text-xs text-slate-500 line-through block">${acc.originalPrice.toLocaleString()}đ</span>
                            <span class="text-lg font-extrabold text-yellow-400">${acc.price.toLocaleString()}đ</span>
                        </div>
                        ${acc.status === 'available' ? `
                            <button onclick="openDetailModal(${acc.id})" class="bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white px-4 py-2 rounded-xl text-xs font-bold transition neon-glow">
                                Mua Ngay
                            </button>
                        ` : `
                            <button disabled class="bg-darkBg text-slate-600 px-4 py-2 rounded-xl text-xs font-bold cursor-not-allowed">
                                Hết Hàng
                            </button>
                        `}
                    </div>
                </div>
            `).join('');
        }

        function getCategoryName(cat) {
            const names = {
                'lq_duoi_1m': 'LQ Dưới 1M',
                'lq_1m_5m': 'LQ 1M - 5M',
                'lq_tren_5m': 'LQ Trên 5M',
                'ff_duoi_1m': 'FF Dưới 1M',
                'ff_tren_5m': 'FF Trên 5M',
                'random_lq': 'Random LQ',
                'random_ff': 'Random FF'
            };
            return names[cat] || 'Game';
        }

        let selectedAccId = null;

        function openDetailModal(id) {
            selectedAccId = id;
            const acc = accounts.find(a => a.id === id);
            const modal = document.getElementById('detailModal');
            const content = document.getElementById('detailContent');

            content.innerHTML = `
                <h3 class="text-xl font-bold mb-4 flex items-center justify-between">
                    <span>Xác Nhận Mua Tài Khoản <span class="text-cyan-400">${acc.code}</span></span>
                </h3>
                <div class="space-y-4 text-sm">
                    <div class="flex gap-4 items-center bg-darkBg p-3 rounded-2xl border border-darkBorder">
                        <img src="${acc.image}" class="w-24 h-24 object-cover rounded-xl">
                        <div>
                            <p class="font-bold text-slate-200">${getCategoryName(acc.category)} - ${acc.rank}</p>
                            <p class="text-yellow-400 font-extrabold text-base mt-1">${acc.price.toLocaleString()}đ</p>
                        </div>
                    </div>
                    <div class="bg-yellow-500/10 border border-yellow-500/30 text-yellow-300 p-3 rounded-xl text-xs">
                        Số dư hiện tại: <b>${userBalance.toLocaleString()}đ</b>. Xác nhận để trừ tiền và nhận thông tin tài khoản.
                    </div>
                    <button onclick="confirmPurchase()" class="w-full bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white py-3 rounded-xl font-bold transition">
                        Xác Nhận Thanh Toán Ngay
                    </button>
                </div>
            `;
            modal.classList.remove('hidden');
        }

        function closeDetailModal() {
            document.getElementById('detailModal').classList.add('hidden');
        }

        function confirmPurchase() {
            const acc = accounts.find(a => a.id === selectedAccId);
            if (userBalance < acc.price) {
                alert('Số dư không đủ! Vui lòng nạp thêm tiền.');
                closeDetailModal();
                openDepositModal();
                return;
            }

            userBalance -= acc.price;
            document.getElementById('userBalance').innerText = userBalance.toLocaleString() + 'đ';
            acc.status = 'sold';
            saveAccountsToStorage();
            renderAccounts();

            document.getElementById('detailContent').innerHTML = `
                <div class="text-center py-4">
                    <div class="w-16 h-16 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl border border-emerald-500/30">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <h3 class="text-xl font-bold text-emerald-400 mb-1">Giao Dịch Thành Công!</h3>
                    <p class="text-xs text-slate-400 mb-4">Thông tin tài khoản/mật khẩu của bạn:</p>
                    <div class="bg-darkBg p-4 rounded-2xl border border-emerald-500/50 text-left mb-4">
                        <div class="bg-black/40 p-3 rounded-xl font-mono text-emerald-400 text-sm select-all border border-darkBorder">
                            ${acc.secret}
                        </div>
                    </div>
                    <button onclick="closeDetailModal()" class="w-full bg-cyan-600 hover:bg-cyan-500 text-white py-2.5 rounded-xl font-bold transition text-sm">
                        Đóng
                    </button>
                </div>
            `;
        }

        function openDepositModal() {
            document.getElementById('depositModal').classList.remove('hidden');
            updateQRCode();
        }

        function closeDepositModal() {
            document.getElementById('depositModal').classList.add('hidden');
        }

        function updateQRCode() {
            const amount = document.getElementById('depositAmount').value || 50000;
            const memo = 'NAP ' + Math.floor(1000 + Math.random() * 9000);
            document.getElementById('qrMemo').innerText = memo;
            document.getElementById('qrBankName').innerText = shopConfig.bankName;
            document.getElementById('qrAccountNo').innerText = shopConfig.bankNo;
            document.getElementById('qrAccountName').innerText = shopConfig.accountName;

            const qrUrl = `https://img.vietqr.io/image/${shopConfig.bankName}-${shopConfig.bankNo}-compact2.png?amount=${amount}&addInfo=${encodeURIComponent(memo)}&accountName=${encodeURIComponent(shopConfig.accountName)}`;
            document.getElementById('qrImage').src = qrUrl;
        }

        function simulateDepositSuccess() {
            const amount = parseInt(document.getElementById('depositAmount').value) || 50000;
            userBalance += amount;
            document.getElementById('userBalance').innerText = userBalance.toLocaleString() + 'đ';
            alert(`Nạp thành công ${amount.toLocaleString()}đ!`);
            closeDepositModal();
        }

        function openAdminModal() {
            document.getElementById('adminModal').classList.remove('hidden');
            if(sessionStorage.getItem('nexus_is_admin') === 'true') {
                showAdminDashboard();
            } else {
                document.getElementById('adminLoginScreen').classList.remove('hidden');
                document.getElementById('adminDashboardContent').classList.add('hidden');
            }
        }

        function closeAdminModal() {
            document.getElementById('adminModal').classList.add('hidden');
        }

        function verifyAdminPassword() {
            const pass = document.getElementById('adminPasswordInput').value;
            if (pass === shopConfig.adminPass) {
                sessionStorage.setItem('nexus_is_admin', 'true');
                showAdminDashboard();
            } else {
                alert('Mật khẩu quản trị không chính xác!');
            }
        }

        function showAdminDashboard() {
            document.getElementById('adminLoginScreen').classList.add('hidden');
            document.getElementById('adminDashboardContent').classList.remove('hidden');
            renderAdminAccountList();
            document.getElementById('settingBankNo').value = shopConfig.bankNo;
            document.getElementById('settingBankName').value = shopConfig.bankName;
            document.getElementById('settingAccountName').value = shopConfig.accountName;
        }

        function logoutAdmin() {
            sessionStorage.removeItem('nexus_is_admin');
            document.getElementById('adminLoginScreen').classList.remove('hidden');
            document.getElementById('adminDashboardContent').classList.add('hidden');
            document.getElementById('adminPasswordInput').value = '';
        }

        function switchAdminTab(tab) {
            document.getElementById('adminTabAdd').classList.add('hidden');
            document.getElementById('adminTabList').classList.add('hidden');
            document.getElementById('adminTabSettings').classList.add('hidden');

            document.getElementById('adminTabAddBtn').className = "bg-darkBg text-slate-400 hover:text-white px-4 py-2 rounded-xl text-xs font-bold transition border border-darkBorder";
            document.getElementById('adminTabListBtn').className = "bg-darkBg text-slate-400 hover:text-white px-4 py-2 rounded-xl text-xs font-bold transition border border-darkBorder";
            document.getElementById('adminTabSettingsBtn').className = "bg-darkBg text-slate-400 hover:text-white px-4 py-2 rounded-xl text-xs font-bold transition border border-darkBorder";

            if (tab === 'add') {
                document.getElementById('adminTabAdd').classList.remove('hidden');
                document.getElementById('adminTabAddBtn').className = "bg-purple-600 text-white px-4 py-2 rounded-xl text-xs font-bold transition";
            } else if (tab === 'list') {
                document.getElementById('adminTabList').classList.remove('hidden');
                document.getElementById('adminTabListBtn').className = "bg-purple-600 text-white px-4 py-2 rounded-xl text-xs font-bold transition";
                renderAdminAccountList();
            } else if (tab === 'settings') {
                document.getElementById('adminTabSettings').classList.remove('hidden');
                document.getElementById('adminTabSettingsBtn').className = "bg-purple-600 text-white px-4 py-2 rounded-xl text-xs font-bold transition";
            }
        }

        function addNewAccount() {
            const category = document.getElementById('newCategory').value;
            let code = document.getElementById('newCode').value.trim();
            const rank = document.getElementById('newRank').value.trim();
            const price = parseInt(document.getElementById('newPrice').value);
            const originalPrice = parseInt(document.getElementById('newOriginalPrice').value) || (price * 2);
            const image = document.getElementById('newImage').value.trim() || 'https://images.unsplash.com/photo-1542751371-adc38448a05e?w=600&auto=format&fit=crop&q=80';
            const highlightsRaw = document.getElementById('newHighlights').value.trim();
            const secret = document.getElementById('newSecret').value.trim();

            if (!rank || !price || !secret) {
                alert('Vui lòng điền Rank/Mô tả, Giá bán và Mật khẩu bí mật!');
                return;
            }

            if (!code) {
                code = '#ACC' + Math.floor(1000 + Math.random() * 9000);
            }

            const highlights = highlightsRaw ? highlightsRaw.split('\n') : ['Full thông tin', 'Bảo hành uy tín'];

            accounts.unshift({
                id: Date.now(),
                code,
                category,
                rank,
                price,
                originalPrice,
                image,
                highlights,
                secret,
                status: 'available'
            });

            saveAccountsToStorage();
            renderAccounts();
            alert('Đăng tài khoản vào danh mục thành công!');
            switchAdminTab('list');
        }

        function renderAdminAccountList() {
            const tbody = document.getElementById('adminAccountTableBody');
            tbody.innerHTML = accounts.map(acc => `
                <tr class="border-b border-darkBorder hover:bg-darkBg/50">
                    <td class="p-3 font-bold text-purple-400">${acc.code}</td>
                    <td class="p-3">${getCategoryName(acc.category)}</td>
                    <td class="p-3 text-yellow-400 font-bold">${acc.price.toLocaleString()}đ</td>
                    <td class="p-3">
                        <select onchange="changeAccStatus(${acc.id}, this.value)" class="bg-darkBg border border-darkBorder rounded-lg px-2 py-1 text-xs text-slate-300">
                            <option value="available" ${acc.status === 'available' ? 'selected' : ''}>Đang bán</option>
                            <option value="sold" ${acc.status === 'sold' ? 'selected' : ''}>Đã bán</option>
                        </select>
                    </td>
                    <td class="p-3 text-right">
                        <button onclick="deleteAccount(${acc.id})" class="text-red-400 hover:text-red-300 p-1"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `).join('');
        }

        function changeAccStatus(id, status) {
            const acc = accounts.find(a => a.id === id);
            if(acc) {
                acc.status = status;
                saveAccountsToStorage();
                renderAccounts();
            }
        }

        function deleteAccount(id) {
            if (confirm('Xóa acc này?')) {
                accounts = accounts.filter(a => a.id !== id);
                saveAccountsToStorage();
                renderAccounts();
                renderAdminAccountList();
            }
        }

        function saveAdminSettings() {
            const newPass = document.getElementById('settingNewPass').value.trim();
            const newBankNo = document.getElementById('settingBankNo').value.trim();
            const newBankName = document.getElementById('settingBankName').value.trim();
            const newAccountName = document.getElementById('settingAccountName').value.trim().toUpperCase();

            shopConfig.bankNo = newBankNo;
            shopConfig.bankName = newBankName;
            shopConfig.accountName = newAccountName;

            localStorage.setItem('nexus_bank_no', newBankNo);
            localStorage.setItem('nexus_bank_name', newBankName);
            localStorage.setItem('nexus_account_name', newAccountName);

            if (newPass) {
                shopConfig.adminPass = newPass;
                localStorage.setItem('nexus_admin_pass', newPass);
            }

            alert('Đã lưu cài đặt thành công!');
        }

        renderAccounts();
    </script>
</body>
</html>
